---

// Responsabilidad: cabecera superior fija de la app (saludo al usuario,
// contadores de tiradas/monedas y botón de logout). Contenido estático;
// los valores se rellenan en runtime vía JS existente (#hdr-tiradas, etc.).
---
<header class="app-header">
  <div class="header-left">
    <a class="brand" href="#" onclick="App.navigateTo('dashboard');return false;" aria-label="Club Collector, ir al inicio">
      <img src="/Futbol_Card-Collector/icons/icon-192.png" alt="" width="30" height="30"/>
      <span class="brand-name">Club Collector</span>
      <span class="brand-season">26/27</span>
    </a>
  </div>
  <div class="header-center">
    <span id="header-greeting">Hola, jugador</span>
  </div>
  <div class="header-right">
    <button class="header-raffle" id="hdr-raffle" type="button" style="display:none" aria-label="Sorteo activo: ver detalles"><span class="hr-dot"></span><span class="hr-txt">SORTEO</span><b class="hr-time">--:--</b><span class="hr-more"></span></button>
    <span class="header-stat" id="hdr-tiradas"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="14" height="18" rx="2"/><path d="M8 21h12a2 2 0 002-2V7a2 2 0 00-2-2h-2"/></svg> <strong>0</strong></span>
    <span class="header-stat" id="hdr-monedas"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h4a1.8 1.8 0 010 3.6h-3a1.8 1.8 0 000 3.6h4"/></svg> <strong>0</strong></span>
    <button class="btn-icon" id="btn-logout" title="Cerrar sesión"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
  </div>
</header>

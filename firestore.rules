rules_version = '2';

// Reglas de seguridad de Firestore para World Cup Collector UES.
// Pega esto en: Firebase Console → Firestore Database → Reglas.
//
// Idea: cada usuario solo puede leer/escribir SU PROPIO documento
// (users/{uid}), identificado por su uid de Firebase Auth. Nadie puede
// leer ni modificar los datos de otro usuario.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
      // Endurecimiento básico anti-trampa: no se permite saldo negativo ni subir
      // las monedas o los puntos de Head Cards de golpe desde la consola del navegador.
      // (Una protección real y completa requiere mover estas reglas de juego al servidor.)
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('monedas', 0) >= 0
        && request.resource.data.get('monedas', 0) - resource.data.get('monedas', 0) <= 20000
        && request.resource.data.get('headPts', 0) - resource.data.get('headPts', 0) <= 60;
    }

    // Config de la app editable solo por la cuenta admin (UID fijo, ver
    // public/js/utils/admin.js). Lectura pública para cualquier usuario
    // logueado (ej. config/live la necesita todo el mundo para ver la
    // transmisión). Esta regla es la única fuente de verdad real de
    // autorización — el chequeo en el frontend es solo para no mostrar la
    // UI de edición a quien no es admin, no un mecanismo de seguridad.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
    }

    // ---- ONLINE (rankings, drops, Head Cards) ----
    // Resumen público de cada jugador: todos pueden leer, solo el dueño escribe.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() < 40
        // El ranking no puede mostrar más que lo que el propio usuario tiene en su documento.
        && request.resource.data.headPts <= get(/databases/$(database)/documents/users/$(uid)).data.get('headPts', 0)
        && request.resource.data.monedas <= get(/databases/$(database)/documents/users/$(uid)).data.get('monedas', 0);
      allow delete: if false;
    }
    // Feed de drops: 1 doc por (carta, usuario); no se puede editar ni borrar.
    match /drops/{dropId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && dropId == request.resource.data.cardId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // ---- PREMIOS DEL ADMIN Y CÓDIGOS CANJEABLES ----
    // Solo el UID admin crea/borra premios y códigos. Cada jugador solo ve los
    // premios dirigidos a SU correo y solo puede marcarlos como entregados
    // (claimed false -> true); no puede crear, editar otros campos ni borrar.
    match /prizes/{id} {
      allow read: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43'
            || resource.data.email == request.auth.token.email.lower());
      allow create, delete: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow update: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43'
            || (resource.data.email == request.auth.token.email.lower()
                && resource.data.claimed == false
                && request.resource.data.claimed == true
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt', 'claimedBy'])));
    }

    // Códigos: cualquiera logueado puede LEER uno si conoce el texto (get), pero
    // nadie puede listarlos salvo el admin. Un jugador solo puede sumar +1 al
    // contador "uses" de un código activo y con cupo.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow create, delete: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow update: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43'
            || (resource.data.active == true
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
                && request.resource.data.uses == resource.data.uses + 1
                && (resource.data.maxUses == 0 || resource.data.uses < resource.data.maxUses)));
    }

    // Un canje por (código, cuenta): el id del documento es CODIGO_uid, así que
    // no se puede canjear dos veces. No se puede editar ni borrar.
    match /redemptions/{rid} {
      allow read: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43' || rid.matches('.*_' + request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.code + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code));
      allow update, delete: if false;
    }

    // ---- SORTEOS (monedas) ----
    // Solo el admin crea, sortea (status open -> done + ganador) y borra sorteos. Todos
    // los jugadores logueados los leen (anuncio y resultado). El ganador solo puede marcar
    // SU premio como reclamado (claimed false -> true, claimedAt, cardId).
    match /raffles/{id} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow update: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43'
            || (resource.data.status == 'done'
                && resource.data.winnerUid == request.auth.uid
                && resource.data.claimed == false
                && request.resource.data.claimed == true
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt', 'cardId'])));

      // Inscripciones: una por jugador (el id del documento es su uid), solo mientras el
      // sorteo está abierto y antes de la hora de cierre. Nadie puede editarlas ni borrarlas.
      // Cada jugador solo ve la suya; el admin lista todas (así saca los correos para sortear).
      match /entries/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43');
        allow list: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && get(/databases/$(database)/documents/raffles/$(id)).data.status == 'open'
          && request.time.toMillis() < get(/databases/$(database)/documents/raffles/$(id)).data.endsAtMs;
        allow update, delete: if false;
      }
    }

    // ---- INTENTOS EXTRA (torneo en persona) ----
    // attemptLimits/{correo en minúsculas}: { daily } = intentos por modo y día para ese correo.
    // Solo el admin los crea/edita/borra; cada jugador solo lee el suyo (el id es su correo).
    match /attemptLimits/{email} {
      allow get: if request.auth != null
        && (request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43' || email == request.auth.token.email.lower());
      allow list: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow create, update, delete: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43'
        && (request.method == 'delete' || (request.resource.data.daily is number && request.resource.data.daily >= 1 && request.resource.data.daily <= 999));
    }

    // Directorio de correos: cada jugador registra el suyo al entrar; SOLO el admin puede leerlo
    // (así ve todos los correos desde su panel). Nadie lo borra.
    match /directory/{uid} {
      allow read: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string && request.resource.data.name.size() < 61;
      allow delete: if false;
    }

    // Salas P2P (solo intercambio de oferta/respuesta WebRTC).
    match /rooms/{code} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Bloquea todo lo demás por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
